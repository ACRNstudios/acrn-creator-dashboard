# Create these values locally and in Vercel Project Settings > Environment Variables.
# Never commit a real .env file or share these secrets in chat.

ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_COMMAND_TOPIC=ACRN_Creator_Commands

# ---- Phase 2: live server monitoring ----
# Added automatically when Neon is connected to the Vercel project (Storage tab).
DATABASE_URL=
# Shared secret Roblox servers send as "Authorization: Bearer <secret>".
# At least 32 characters. Store the SAME value in Roblox Creator Hub > Secrets.
ROBLOX_TELEMETRY_SECRET=
# Optional timing (seconds). Defaults: 30 / 75 / 180.
# SERVER_HEARTBEAT_INTERVAL_SECONDS=30
# SERVER_STALE_AFTER_SECONDS=75
# SERVER_OFFLINE_AFTER_SECONDS=180
